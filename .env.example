DATABASE_URL="file:./prisma/dev.db"

# ── LinkedIn via Maton Gateway ──
# Get your API key at https://ctrl.maton.ai
# Set up a LinkedIn connection there first.
MATON_API_KEY=""
# Optional: force old V1 API (default = gateway)
# MATON_API_VERSION="v1"
# Optional: pin a specific Maton connection
# MATON_CONNECTION_ID=""
# Your LinkedIn person or organization URN (discovered via /api/profile)
# LINKEDIN_AUTHOR_URN="urn:li:person:xxxxxxxxxx"

# ── LLM (default: local Ollama) ──
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_API_KEY=""
LLM_TIMEOUT_MS="120000"
